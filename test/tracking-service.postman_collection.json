{
  "info": {
    "name": "Tracking Service API Tests",
    "_postman_id": "b2c3d4e5-f6a7-4890-bcde-f12345678901",
    "description": "API tests for tracking-service.\n\nThere is no OTP. Signed-in customers use the login token issued by user-order-service (same JWT_SECRET):\n1. Run 'Auth > Login' - it stores 'authToken'. Set testEmail/testPassword in the environment first (use an account that has orders on the storefront in 'origin').\n2. Run the Orders and Address Change folders - they send 'Authorization: Bearer {{authToken}}'.\n\nThe storefront is detected from the Origin header, so keep 'origin' set to a storefront in the domains table (e.g. https://noverafitness.com).\n\nThe carrier tracking request uses x-api-key (set 'apiKey' to TRACKING_API_KEY).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "testOrderNumber",
      "value": ""
    },
    {
      "key": "createdAddressChangeRequestId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health (root)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('DB connected', () => { const j = pm.response.json(); pm.expect(j.ok).to.be.true; pm.expect(j.db).to.eql('connected'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Health (/api)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/trackingdetail/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "trackingdetail",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (user-order-service)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{origin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{userOrderUrl}}/api/auth/login",
              "host": [
                "{{userOrderUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Returns a token', () => pm.expect(j.token).to.be.a('string'));",
                  "pm.collectionVariables.set('authToken', j.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "List my orders",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{origin}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/trackingdetail/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "trackingdetail",
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"limit\": 50\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Has orders array', () => pm.expect(j.orders).to.be.an('array'));",
                  "if (j.orders.length) pm.collectionVariables.set('testOrderNumber', j.orders[0].order.order_number);"
                ]
              }
            }
          ]
        },
        {
          "name": "List orders - no token (expects 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{origin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/trackingdetail/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "trackingdetail",
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"someone@example.com\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Address Change",
      "item": [
        {
          "name": "Create address change request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{origin}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/trackingdetail/order/{{testOrderNumber}}/address-change-request",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "trackingdetail",
                "order",
                "{{testOrderNumber}}",
                "address-change-request"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shipping_address\": \"99 New Street\",\n  \"shipping_city\": \"Manchester\",\n  \"shipping_zip\": \"M1 1AA\",\n  \"shipping_country\": \"United Kingdom\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 created, or 409 if one is already pending', () => pm.expect([200, 409]).to.include(pm.response.code));",
                  "if (pm.response.code === 200) pm.collectionVariables.set('createdAddressChangeRequestId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List my address change requests",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Origin",
                "value": "{{origin}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/trackingdetail/address-change-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "trackingdetail",
                "address-change-requests"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has requests array', () => pm.expect(pm.response.json().requests).to.be.an('array'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Carrier Tracking",
      "item": [
        {
          "name": "Carrier events",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/trackingdetail/tracking/AB123456789GB",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "trackingdetail",
                "tracking",
                "AB123456789GB"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200, or 400 when no provider is configured', () => pm.expect([200, 400]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}